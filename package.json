{
  "name": "skiworld",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "simulate": "tsx scripts/simulate.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "smoke": "node scripts/smoke.mjs",
    "flows": "node scripts/flows.mjs",
    "perf": "node scripts/perf.mjs",
    "soak": "tsx scripts/soak.ts",
    "legal": "tsx scripts/make-legal.ts",
    "tune": "tsx scripts/tune.ts",
    "icons": "node scripts/make-icons.mjs && npx @capacitor/assets generate --android --ios --iconBackgroundColor #8FC4E8 --splashBackgroundColor #8FC4E8",
    "cap:sync": "cap sync"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/native-purchases": "^8.8.1",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@types/node": "^26.6.3",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
